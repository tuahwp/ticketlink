# Database Connection (Supabase Transaction Pooler URL - port 6543)
# Used by Prisma Client for everyday queries (with pgbouncer pooling active)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Database Connection for migrations (Supabase Session Pooler / Direct URL - port 5432)
# Used by Prisma Migrations because DDL transactions cannot run through PgBouncer in transaction mode
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Client Credentials (Required for Auth & Realtime updates)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
