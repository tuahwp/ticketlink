// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model State {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model Maincon {
  id                 Int               @id @default(autoincrement())
  name               String
  sheetName          String
  customFieldsSchema Json              // Stores array of field names or { default: string[], endCustomers: Record<string, string[]> }
  siteCustomers      Json?             // Stores list of end-customers, e.g. ["JPJ", "RELA"]
  tickets            Ticket[]
  endCustomerSites   EndCustomerSite[]
  inventoryItems     InventoryItem[]
}

model ServicePartner {
  id            Int             @id @default(autoincrement())
  name          String
  statesCovered Json            // Stores array of state names, e.g. ["Selangor", "Kuala Lumpur"]
  address       String?
  phone         String?
  dispatchEmail String?         // Central dispatch inbox, e.g. support@partner.com
  companyPhotoUrl String?
  engineers     FieldEngineer[]
  tickets       Ticket[]
  users         User[]
  registrationCodes RegistrationCode[]
  warehouses        Warehouse[]
  replacementClaims PartReplacementClaim[]
}

model FieldEngineer {
  id        Int            @id @default(autoincrement())
  name      String
  phone     String
  email     String?        @unique
  partnerId Int
  partner   ServicePartner @relation(fields: [partnerId], references: [id])
  tickets   Ticket[]
  country   String?
  region    String?
  user      User?
}

model DeviceCatalog {
  id           Int      @id @default(autoincrement())
  category     String   // Desktop, Laptop, Printer, Router, POS
  brand        String
  model        String
  isStandard   Boolean
  restrictedTo String?  // End-customer restricted to, e.g. "JPJ"
  tickets      Ticket[]
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  FOLLOW_UP
  COMPLETE
  CLOSED
  CANCELLED
}

enum DeviceStatus {
  STANDARD
  ON_REQUEST
}

enum Severity {
  P1
  P2
  P3
  P4
  NA
}

model Ticket {
  id               Int          @id @default(autoincrement())
  ticketRefNo      String?
  clientSiteName   String
  state            String
  issueDescription String
  status           TicketStatus @default(NEW)
  subStatus        String?      // PENDING_PARTS, PENDING_SIGN_OFF, MONITORING
  severity         Severity?
  slaDeadline      DateTime?
  endCustomer      String?
  reportedAt       DateTime     @default(now())

  // Dynamic Data
  mainconId    Int
  maincon      Maincon @relation(fields: [mainconId], references: [id])
  customValues Json    // Stores values matching Maincon customFieldsSchema

  // Service Data
  partnerId    Int?
  partner      ServicePartner? @relation(fields: [partnerId], references: [id])
  assignedFeId Int?
  assignedFe   FieldEngineer?  @relation(fields: [assignedFeId], references: [id])

  // Device Data
  deviceId            Int?
  device              DeviceCatalog? @relation(fields: [deviceId], references: [id])
  deviceStatus        DeviceStatus?
  customDeviceDetails String?        // Used if model is not in standard catalog
  
  // Link to Pre-seeded End-Customer Site branch
  siteId              Int?
  site                EndCustomerSite? @relation(fields: [siteId], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Resolution fields
  resolutionDetails String?   // free‑form notes on how the issue was solved
  resolvedAt DateTime?        // timestamp when the ticket was marked resolved
  serviceReportUrl  String?   // URL to the uploaded service report (PDF/photo)
  defectiveSerial   String?   // Serial number of defective part returned
  defectiveReturnStatus String? // PENDING, RETURNED, NOT_APPLICABLE

  // SLA Pause, ETA, and FE Acknowledgement enhancements
  eta                 DateTime?
  slaPaused           Boolean          @default(false)
  slaPausedAt         DateTime?
  totalPausedMs       Int              @default(0)
  feAcknowledgeStatus String?          // PENDING, ACKNOWLEDGED, DECLINED
  feAcknowledgedAt    DateTime?
  holdReason          String?
  // Creator information (Superadmin or Moderator who created the ticket)
  createdById         String?
  createdByName       String?
  createdBy           User?            @relation("CreatedTickets", fields: [createdById], references: [id])

  activities          TicketActivity[]
  spareParts          TicketSparePart[]
  replacementClaims   PartReplacementClaim[]
}

model EndCustomerSite {
  id        Int      @id @default(autoincrement())
  name      String   // e.g. "JPJ Kuala Lumpur", "JPJ Labuan"
  group     String   // e.g. "JPJ", "RELA"
  state     String   // e.g. "Kuala Lumpur", "Labuan"
  mainconId Int
  maincon   Maincon  @relation(fields: [mainconId], references: [id], onDelete: Cascade)
  tickets   Ticket[]
}

model CustomerSla {
  id        Int      @id @default(autoincrement())
  customer  String   // Maincon/Client/End-Customer name, or "DEFAULT"
  severity  Severity // P1, P2, P3, P4, NA
  region    String   // "Semenanjung", "Sabah/Sarawak", "DEFAULT"
  slaHours  Int      // e.g., 2, 4, 8, 24, 48 hours
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customer, severity, region])
}

model TicketActivity {
  id            Int      @id @default(autoincrement())
  ticketId      Int
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type          String   // "STATUS_CHANGE", "COMMENT", "ASSIGNMENT", "ETA_UPDATE", "SLA_PAUSE", "SLA_RESUME", "FE_ACKNOWLEDGE", "REPORT_UPLOAD"
  status        String?
  subStatus     String?
  notes         String?  // what was done, hold reason, ETA comments, etc.
  attachmentUrl String?  // attached service report, daily visit slip, photo
  author        String   @default("System")
  createdAt     DateTime @default(now())
}

enum UserRole {
  SUPERADMIN
  MODERATOR
  AGENT
  FIELD_ENGINEER
}

model User {
  id                         String          @id // matches user UUID
  email                      String          @unique
  name                       String?
  avatarUrl                  String?
  passwordHash               String?         // bcrypt hashed password for native auth
  role                       UserRole        @default(FIELD_ENGINEER)
  isActive                   Boolean         @default(true)
  isEmailVerified            Boolean         @default(false)
  emailVerificationOtp       String?         // 6-digit OTP
  emailVerificationToken     String?         @unique // URL token
  emailVerificationExpiresAt DateTime?
  partnerId                  Int?            // associated ServicePartner for AGENT role
  partner                    ServicePartner? @relation(fields: [partnerId], references: [id])
  engineerId                 Int?            @unique // associated FieldEngineer for FIELD_ENGINEER role
  engineer                   FieldEngineer?  @relation(fields: [engineerId], references: [id])
  createdTickets             Ticket[]        @relation("CreatedTickets")
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
}

model RegistrationCode {
  id        Int            @id @default(autoincrement())
  code      String         @unique
  role      UserRole
  partnerId Int
  partner   ServicePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  maxUses   Int            @default(1)
  uses      Int            @default(0)
  createdAt DateTime       @default(now())
  expiresAt DateTime?
}

enum InventoryTrackingType {
  SERIALIZED
  BULK
}

enum StockOwnership {
  HQ_CONSIGNED
  PARTNER_OWNED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  IN_TRANSIT
  INSTALLED
  ON_LOAN
  RETURN_IN_TRANSIT
  UNDER_INSPECTION
  DEFECTIVE_PENDING_RETURN
  DEFECTIVE_RETURNED_TO_VENDOR
  SCRAPPED
}

enum SparePartRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  REQUESTED
  ALLOCATED
  DISPATCHED
  INSTALLED
  ON_LOAN
  RETURN_IN_TRANSIT
  RETURNED
  CANCELLED
}

enum ClaimStatus {
  PENDING
  APPROVED_REPLENISH
  APPROVED_REIMBURSE
  REJECTED
  CANCELLED
}

model Warehouse {
  id                  Int                 @id @default(autoincrement())
  name                String
  state               String
  address             String?
  contactPerson       String?
  contactPhone        String?
  partnerId           Int?
  partner             ServicePartner?     @relation(fields: [partnerId], references: [id])
  items               InventoryItem[]
  outgoingTransfers   WarehouseTransfer[] @relation("SourceWarehouse")
  incomingTransfers   WarehouseTransfer[] @relation("DestWarehouse")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model InventoryItem {
  id                Int                   @id @default(autoincrement())
  name              String
  partNumber        String?
  category          String
  serialNumber      String?               @unique
  trackingType      InventoryTrackingType @default(SERIALIZED)
  ownership         StockOwnership        @default(HQ_CONSIGNED)
  quantity          Int                   @default(1)
  availableQuantity Int                   @default(1)
  costPrice         Float?
  group             String?               // e.g. "JPJ", "RELA", "General Pool"
  mainconId         Int?
  maincon           Maincon?              @relation(fields: [mainconId], references: [id], onDelete: SetNull)
  warehouseId       Int
  warehouse         Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status            InventoryStatus       @default(AVAILABLE)
  isLoaner          Boolean               @default(false)
  dateAdded         DateTime              @default(now())
  supplier          String?
  notes             String?
  ticketAllocations TicketSparePart[]
  transferItems     WarehouseTransferItem[]
  replacementClaims PartReplacementClaim[]
  logs              InventoryLog[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model WarehouseTransfer {
  id                    Int                     @id @default(autoincrement())
  sourceWarehouseId     Int
  sourceWarehouse       Warehouse               @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouseId Int
  destinationWarehouse  Warehouse               @relation("DestWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  courierName           String?
  trackingNo            String?
  notes                 String?
  status                String                  @default("IN_TRANSIT") // "IN_TRANSIT", "RECEIVED", "CANCELLED"
  transferredBy         String                  @default("System")
  receivedBy            String?
  receivedAt            DateTime?
  items                 WarehouseTransferItem[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model WarehouseTransferItem {
  id              Int               @id @default(autoincrement())
  transferId      Int
  transfer        WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItemId Int
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  quantity        Int               @default(1)
}

model TicketSparePart {
  id                      Int                    @id @default(autoincrement())
  ticketId                Int
  ticket                  Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  inventoryItemId         Int?
  inventoryItem           InventoryItem?         @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  requestedPartName       String
  quantity                Int                    @default(1)
  status                  SparePartRequestStatus @default(PENDING_APPROVAL)
  isLoaner                Boolean                @default(false)
  expectedReturnDate      DateTime?
  loanDurationDays        Int?                   @default(14)
  returnInitiatedAt       DateTime?
  returnCourierName       String?
  returnTrackingNo        String?
  returnReceivedAt        DateTime?
  returnCondition         String?
  loanNotes               String?
  courierName             String?
  dispatchTrackingNo      String?
  batchTrackingNo         String?
  dispatchedAt            DateTime?
  installedAt             DateTime?
  replacedDefectiveSerial String?
  requestedBy             String?
  approvedBy              String?
  approvedAt              DateTime?
  rejectionReason         String?
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

model PartReplacementClaim {
  id                Int             @id @default(autoincrement())
  ticketId          Int
  ticket            Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  partnerId         Int
  partner           ServicePartner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  inventoryItemId   Int?
  inventoryItem     InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  partName          String
  serialNumber      String?
  defectiveSerial   String?
  claimAmount       Float?
  status            ClaimStatus     @default(PENDING)
  settlementType    String?         // "HARDWARE_REPLENISHMENT", "FINANCIAL_REIMBURSEMENT"
  replacementItemId Int?
  requestedBy       String
  approvedBy        String?
  approvedAt        DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model InventoryLog {
  id              Int           @id @default(autoincrement())
  inventoryItemId Int
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  action          String
  notes           String?
  author          String        @default("System")
  createdAt       DateTime      @default(now())
}

model SmtpConfig {
  id        Int      @id @default(autoincrement())
  host      String   @default("smtp.gmail.com")
  port      Int      @default(465)
  secure    Boolean  @default(true)
  user      String   // e.g. support@neutron.com.my
  password  String   // Google Workspace App Password
  fromName  String   @default("TicketLink Support")
  fromEmail String   // e.g. support@neutron.com.my
  adminCc   String?  // Global audit CC email, e.g. admin@neutron.com.my
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model EmailTemplate {
  id           Int      @id @default(autoincrement())
  eventKey     String   @unique // AUTH_RESET_PASSWORD, AUTH_WELCOME_USER, TICKET_ASSIGNED, TICKET_STATUS_CHANGED, TICKET_SLA_ALERT
  title        String
  description  String?
  subject      String
  bodyHtml     String
  isEnabled    Boolean  @default(true)
  placeholders Json     // Array of placeholder strings e.g. ["{{userName}}", "{{resetLink}}"]
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}



